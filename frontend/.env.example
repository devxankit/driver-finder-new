# Where the API lives.
# Development: leave VITE_API_URL empty; Vite proxies /api and /uploads to VITE_API_PROXY_TARGET.
# Production (same domain behind nginx): leave empty. Different domain: https://api.example.com
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_PORT=5173

# Google Play link for the landing page buttons (empty = "Coming soon")
VITE_PLAY_STORE_URL=
