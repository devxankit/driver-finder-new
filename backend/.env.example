NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Admin panel + landing page origins (comma-separated)
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/driver_finder?retryWrites=true&w=majority

# Long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=90d
ADMIN_JWT_EXPIRES_IN=12h

# 1 behind nginx on the VPS
TRUST_PROXY=0

# ---------------------------------------------------------------- OTP
# true  = send a real SMS through SMS India Hub
# false = no SMS; the app fills in the OTP by itself
OTP_ENABLED=false
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
TEST_PHONE_NUMBERS=
TEST_OTP_CODE=

# SMS India Hub (use APIKey, or user + password)
SMSINDIAHUB_URL=https://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMSINDIAHUB_API_KEY=
SMSINDIAHUB_USER=
SMSINDIAHUB_PASSWORD=
SMSINDIAHUB_SENDER_ID=
SMSINDIAHUB_GWID=2
SMSINDIAHUB_TEMPLATE_ID=
SMSINDIAHUB_PE_ID=
SMSINDIAHUB_MESSAGE=Your Driver Finder login OTP is {otp}. It is valid for 5 minutes. Do not share it with anyone.

# ----------------------------------------------------------- Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -------------------------------------------------------------- Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# First super admin (npm run seed / npm run create-admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@driverfinder.in
ADMIN_PASSWORD=
