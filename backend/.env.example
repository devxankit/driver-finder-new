NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Admin panel + landing page origins (comma-separated)
CLIENT_URL=http://localhost:5173

MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/driver_finder?retryWrites=true&w=majority

# Long random string (e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=
JWT_EXPIRES_IN=90d
ADMIN_JWT_EXPIRES_IN=12h

# 1 behind nginx on the VPS
TRUST_PROXY=0

# Built website to serve from this server too (VPS: ../frontend/dist). Empty = API only.
WEB_DIST=

# ---------------------------------------------------------------- OTP
# true  = send a real SMS through SMS India Hub
# false = no SMS; the app fills in the OTP by itself
OTP_ENABLED=false
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=30
# Numbers that never get an SMS and always accept TEST_OTP_CODE (internal QA).
TEST_PHONE_NUMBERS=
TEST_OTP_CODE=
# Google Play review accounts (also sign in with TEST_OTP_CODE, no SMS). They are
# set up again on every sign-in: profile, KYC approved, registration, a plan.
# Put these two numbers and the code in Play Console -> App access.
REVIEW_DRIVER_PHONE=
REVIEW_OWNER_PHONE=

# SMS India Hub (use APIKey, or user + password)
SMSINDIAHUB_URL=https://cloud.smsindiahub.in/vendorsms/pushsms.aspx
SMSINDIAHUB_API_KEY=
SMSINDIAHUB_USER=
SMSINDIAHUB_PASSWORD=
SMSINDIAHUB_SENDER_ID=
SMSINDIAHUB_GWID=2
SMSINDIAHUB_TEMPLATE_ID=
SMSINDIAHUB_PE_ID=
# OTP_ENABLED=true sends real SMS through SMS India Hub with the settings below
# (OTP_ENABLED=false: no SMS, the app fills in the code by itself). Each SMSINDIAHUB_*
# setting also accepts the SMS_INDIA_HUB_* spelling (SMS_INDIA_HUB_ENTITY_ID = PE id).
# SMSINDIAHUB_MESSAGE must match the DLT template word for word; {otp} or {#var#} = the code.
SMSINDIAHUB_MESSAGE=Your Driver Finder login OTP is {otp}. It is valid for 5 minutes. Do not share it with anyone.

# ----------------------------------------------------------- Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# -------------------------------------------------------------- Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=8388608

# First super admin (npm run seed / npm run create-admin)
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@driverfinder.in
ADMIN_PASSWORD=

# Phone push notifications (Firebase Cloud Messaging): path to the service-account JSON
# from Firebase console -> Project settings -> Service accounts. Keep it out of git
# (backend/secrets/ is ignored). Empty = no push; everything else still works.
FIREBASE_SERVICE_ACCOUNT=
